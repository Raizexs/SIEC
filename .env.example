# Copy this file to .env and fill in your local values.

# Backend / API
DATABASE_URL=postgresql://postgres:postgres@db:5432/siec
ALLOW_ANONYMOUS_DEV=true
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000

# Scraper
RUN_NOW=false
TZ=America/Santiago
CMF_API_KEY=replace-me
SERPAPI_METALCON_API_KEY=replace-me
